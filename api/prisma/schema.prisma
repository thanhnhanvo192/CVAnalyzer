// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  passwordHash    String
  name            String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  cvs             CV[]
  jobDescriptions JobDescription[]
  matchResults    MatchResult[]
}

// CV
enum CvStatus {
  PROCESSING
  READY
  FAILED
}

model CV {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  rawText      String        @db.Text
  status       CvStatus      @default(PROCESSING)
  errorMessage String?
  createdAt    DateTime      @default(now())
  matchResults MatchResult[]

  @@index([userId])
}

// Job Description
model JobDescription {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String?
  company      String?
  rawText      String        @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  matchResults MatchResult[]

  @@index([userId])
}

// AI Match Result
model MatchResult {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  cvId             String
  cv               CV             @relation(fields: [cvId], references: [id], onDelete: Cascade)
  jobDescriptionId String
  jobDescription   JobDescription @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)

  overallScore     Int
  summary          String         @db.Text
  matchedSkills    Json           // Array of { skill: string, evidence: string }
  missingSkills    Json           // Array of { skill: string, importance: "HIGH"|"MEDIUM"|"LOW", reason: string }
  recommendations  Json           // Array of strings

  createdAt        DateTime       @default(now())

  @@index([userId])
  @@index([cvId])
  @@index([jobDescriptionId])
}